APP_NAME=AssessPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://assesspay.deoris.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=assesspay
DB_USERNAME=root
DB_PASSWORD=

# Read-only cross-module DB (cashier student list + school year terms)
DEORIS_DB_HOST=127.0.0.1
DEORIS_DB_PORT=3306
DEORIS_DB_DATABASE=deoris_identity_db
DEORIS_DB_USERNAME=root
DEORIS_DB_PASSWORD=

ENROLLEASE_DB_HOST=127.0.0.1
ENROLLEASE_DB_PORT=3306
ENROLLEASE_DB_DATABASE=enrollease
ENROLLEASE_DB_USERNAME=root
ENROLLEASE_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.deoris.test
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=none

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@assesspay.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AssessPay SOA Service
ASSESSPAY_SERVICE_NAME=AssessPay
ASSESSPAY_SERVICE_KEY=assesspay-service
ASSESSPAY_SERVICE_URL=https://assesspay.deoris.test
ASSESSPAY_API_VERSION=v1
ASSESSPAY_EVENT_SECRET=change-me-assesspay
ASSESSPAY_API_RATE_LIMIT=120

PORTAL_BASE_URL=https://deoris.test
APP_PORTAL_URL=https://deoris.test
AUTH_SERVICE_URL=https://deoris.test
AUTH_VERIFY_SSL=false
EVENT_HUB_URL=https://events.deoris.test/api/v1/publish
CLEARCHECK_API_URL=https://clearcheck.deoris.test/api/v1
CLEARCHECK_SERVICE_KEY=clearcheck-service
CLEARCHECK_CACHE_TTL=300
ENROLLEASE_API_URL=https://enrollease.deoris.test/api/v1
ENROLLEASE_API_KEY=change-me-enrollease-api-key
ENROLLEASE_VERIFY_SSL=false

REDIS_CHANNEL_BILLING=billing.events
REDIS_CHANNEL_PAYMENTS=payments.notifications
QUEUE_PAYMENTS=payments
QUEUE_BILLING=billing
QUEUE_NOTIFICATIONS=notifications
QUEUE_EVENTS=events

